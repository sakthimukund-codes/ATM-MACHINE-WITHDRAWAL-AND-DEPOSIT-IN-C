#include <stdio.h>

int main() {
    int b = 5000, a, ch;

    printf("1. Withdrawal\n2. Deposit\n");
    scanf("%d", &ch);

    printf("Enter amount: ");
    scanf("%d", &a);

    if (ch == 1 && a > 0 && a <= b)
        printf("Balance = %d", b - a);
    else if (ch == 2 && a > 0)
        printf("Balance = %d", b + a);
    else
        printf("Invalid amount");

    return 0;
}